# Runtime-only image for CI releases: the binary comes pre-built from the
# release-please workflow's `build` job (same source, same commit - just
# compiled once instead of once per matrix leg here too). No Rust toolchain,
# no compiling, no QEMU exposure. Local/standalone builds still use the
# regular Dockerfile, which compiles from source.

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    zlib1g \
    curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -r -u 1000 -m vein

# Expects `vein` (the release binary for this image's target platform) at
# the build context root - the CI job extracts it there before building.
COPY vein /usr/local/bin/vein
RUN chmod +x /usr/local/bin/vein

WORKDIR /data
RUN chown -R vein:vein /data

USER vein

EXPOSE 8346

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -fsS http://localhost:8346/up || exit 1

ENTRYPOINT ["/usr/local/bin/vein"]
CMD ["serve"]
